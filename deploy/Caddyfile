# /etc/caddy/Caddyfile — TLS termination for the idlegrid coordinator.
# Caddy obtains and renews Let's Encrypt certificates automatically.
#
# ── THE DOMAIN LIVES ONLY IN THIS FILE ──────────────────────────────────
# Current: api.sqlguroo.com (temporary — real product domain comes later).
# To swap later: change the two lines below to the new domain, then:
#     systemctl reload caddy
# Providers installed with the old URL need the install command re-run with
# the new URL (one line per Mac; see DEPLOY.md "Swapping domains").
# ────────────────────────────────────────────────────────────────────────

api.sqlguroo.com {
	reverse_proxy localhost:8090
}

