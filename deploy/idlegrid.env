# /etc/idlegrid/env — coordinator configuration
# Developer API keys (comma-separated). Generate with: openssl rand -hex 24
IDLEGRID_API_KEYS=change-me-to-a-long-random-key

# Join code that provider Macs must present to register.
# Generate with: openssl rand -hex 8  (e.g. 9f3ac1b2e5d4c6a7)
IDLEGRID_PROVIDER_CODE=change-me-too

PORT=8090
